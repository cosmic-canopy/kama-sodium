import { sodium::SodiumError, sodium::Nonce, sodium::ready, sodium::kx::SessionKeys, sodium::kx::Direction,
         std::collections::View, std::collections::ConstView, std::collections::FixedArray };
export { Key, KEYBYTES, MACBYTES, seal, open, sealInto, openInto };

// Authenticated encryption WITH associated data: XChaCha20-Poly1305-IETF. The same contract as
// `secretbox` — one shared key, a nonce never reused under it, a ciphertext MACBYTES longer than its
// message — plus `ad`: bytes that travel in the clear, are not encrypted, and are still covered by the
// MAC. A packet header (sequence number, channel, flags) goes there, so a peer can route and reorder on
// the plaintext header and `open` still refuses a header that was altered or moved to another packet.
// This is the primitive a protocol wants; `secretbox` is the one a single blob wants.
//
// XChaCha over ChaCha: the 24-byte nonce, so `Nonce.random()` per message is safe with no bookkeeping
// (the IETF ChaCha20-Poly1305's 12-byte nonce is not, and AES-GCM is fast only with hardware).

comptime isize KEYBYTES = 32;   // crypto_aead_xchacha20poly1305_ietf_KEYBYTES, pinned in csrc/kama_sodium.c
comptime isize MACBYTES = 16;   // crypto_aead_xchacha20poly1305_ietf_ABYTES

extern "kama_sodium.h";
extern fn void  crypto_aead_xchacha20poly1305_ietf_keygen(UnsafePtr<uint8> k);
extern fn int32 kama_sodium_aead_encrypt(UnsafePtr<uint8> c, UnsafeConstPtr<uint8> m, uint64 mlen,
                                         UnsafeConstPtr<uint8> ad, uint64 adlen,
                                         UnsafeConstPtr<uint8> npub, UnsafeConstPtr<uint8> k);
extern fn int32 kama_sodium_aead_decrypt(UnsafePtr<uint8> m, UnsafeConstPtr<uint8> c, uint64 clen,
                                         UnsafeConstPtr<uint8> ad, uint64 adlen,
                                         UnsafeConstPtr<uint8> npub, UnsafeConstPtr<uint8> k);
extern fn void  sodium_memzero(UnsafePtr<uint8> pnt, usize len);

// The key: move-only, zeroed on drop. Born random, imported from bytes, or taken from a `kx` session
// key without the bytes ever sitting in a caller's buffer.
type resource Key {
    InlineArray<uint8>#(32) bytes;

    // All-zero bytes, to be filled by the constructor that mints one. Private: every path that mints
    // a key fills it before it leaves, and a zero key is not a thing a caller should be able to make.
    ctor zeroed() { this.bytes = [0; 32]; }

    public unsafe ctor random() {
        ready();
        this.bytes = [0; 32];
        crypto_aead_xchacha20poly1305_ietf_keygen(k: this.bytes.dataPtrMut());
    }

    public unsafe ctor Result<Key, SodiumError> fromBytes(ConstView<uint8> bytes) {
        if (bytes.length() != KEYBYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: KEYBYTES, got: bytes.length()));
        }
        Key k = Key.zeroed();
        isize i = 0;
        while (i < KEYBYTES) { k.bytes[cast<usize>(i)] = bytes[i]; i = i + 1; }
        return Result::Ok(value: k);
    }

    // A `kx` session key IS an XChaCha20-Poly1305 key (both 32 bytes, both uniformly random); this is
    // the hand-off from a key exchange to a channel, with no plaintext copy in between.
    public unsafe ctor fromSession(const ref SessionKeys keys, Direction direction) {
        this.bytes = [0; 32];
        keys.copyInto(direction: direction, dst: this.bytes.dataPtrMut());
    }

    public unsafe const fn void exportTo(View<uint8> into) {
        if (into.length() != KEYBYTES) { panic(msg: "aead::Key.exportTo: the buffer is not KEYBYTES long"); }
        isize i = 0;
        while (i < KEYBYTES) { into[i] = this.bytes[cast<usize>(i)]; i = i + 1; }
    }

    // The bytes, for libsodium: read-only and `const`, so a `const ref Key` can reach C. Every path
    // that WRITES them (`random`, `fromSession`, the destructor) is inside the type and uses
    // `dataPtrMut()` directly, so there is no writable accessor to hand out.
    // Not public: a raw pointer into a key is this package's business. Only the two operations that
    // hand one to libsodium may ask.
    friend sodium::aead::sealInto[raw];
    friend sodium::aead::openInto[raw];
    unsafe const fn UnsafeConstPtr<uint8> raw() { return this.bytes.dataPtr(); }

    unsafe ~Key() { sodium_memzero(pnt: this.bytes.dataPtrMut(), len: cast<usize>(KEYBYTES)); }
}

// Encrypt `message`, authenticating it together with `ad`, into `into` (exactly message.length() +
// MACBYTES). `ad` may be empty. Answers the bytes written; allocates nothing.
unsafe fn isize sealInto(View<uint8> into, ConstView<uint8> message, ConstView<uint8> ad,
                         const ref Nonce nonce, const ref Key key) {
    ready();
    if (into.length() != message.length() + MACBYTES) {
        panic(msg: "aead::sealInto: `into` must be message.length() + MACBYTES");
    }
    // An empty message and empty associated data are both valid. libsodium wants a pointer it will
    // not read rather than NULL, and a zero-length window has no address to give, so the output buffer
    // -- always at least MACBYTES long here -- stands in.
    UnsafeConstPtr<uint8> m = addr(of: into[0]);
    if (message.length() != 0) { m = addr(of: message[0]); }
    UnsafeConstPtr<uint8> a = addr(of: into[0]);
    if (ad.length() != 0) { a = addr(of: ad[0]); }
    int32 rc = kama_sodium_aead_encrypt(c: addr(of: into[0]), m: m, mlen: cast<uint64>(message.length()),
                                        ad: a, adlen: cast<uint64>(ad.length()), npub: nonce.raw(), k: key.raw());
    if (rc != 0) { panic(msg: "aead::sealInto: encryption failed"); }
    return into.length();
}

// Verify `ciphertext` against `ad`, and decrypt it into `into` (exactly ciphertext.length() - MACBYTES).
// `Err(Forged)` if the ciphertext OR the associated data differ from what was sealed, or the key or
// nonce do; `into` is then not to be trusted.
unsafe fn Result<isize, SodiumError> openInto(View<uint8> into, ConstView<uint8> ciphertext, ConstView<uint8> ad,
                                              const ref Nonce nonce, const ref Key key) {
    ready();
    if (ciphertext.length() < MACBYTES) {
        return Result::Err(error: SodiumError::BadLength(expected: MACBYTES, got: ciphertext.length()));
    }
    isize plain = ciphertext.length() - MACBYTES;
    if (into.length() != plain) {
        panic(msg: "aead::openInto: `into` must be ciphertext.length() - MACBYTES");
    }
    // The plaintext may be empty (a ciphertext that is a bare MAC), and `into` is then zero-length
    // with no address to give. A one-byte cell stands in as the destination; libsodium writes none of
    // it. The ciphertext is never the destination -- it is read-only now, and always was in fact.
    InlineArray<uint8>#(1) unused = [0; 1];
    UnsafePtr<uint8> m = unused.dataPtrMut();
    if (plain != 0) { m = addr(of: into[0]); }
    UnsafeConstPtr<uint8> a = addr(of: ciphertext[0]);
    if (ad.length() != 0) { a = addr(of: ad[0]); }
    int32 rc = kama_sodium_aead_decrypt(m: m, c: addr(of: ciphertext[0]), clen: cast<uint64>(ciphertext.length()),
                                        ad: a, adlen: cast<uint64>(ad.length()), npub: nonce.raw(), k: key.raw());
    if (rc != 0) { return Result::Err(error: SodiumError::Forged); }
    return Result::Ok(value: plain);
}

unsafe fn FixedArray<uint8> seal(ConstView<uint8> message, ConstView<uint8> ad, const ref Nonce nonce, const ref Key key) {
    FixedArray<uint8> buf = FixedArray::<uint8>.make(size: message.length() + MACBYTES);
    isize n = sealInto(into: buf.viewMut(), message: message, ad: ad, nonce: nonce, key: key);
    return buf;
}

unsafe fn Result<FixedArray<uint8>, SodiumError> open(ConstView<uint8> ciphertext, ConstView<uint8> ad,
                                                      const ref Nonce nonce, const ref Key key) {
    if (ciphertext.length() < MACBYTES) {
        return Result::Err(error: SodiumError::BadLength(expected: MACBYTES, got: ciphertext.length()));
    }
    FixedArray<uint8> buf = FixedArray::<uint8>.make(size: ciphertext.length() - MACBYTES);
    match (openInto(into: buf.viewMut(), ciphertext: ciphertext, ad: ad, nonce: nonce, key: key)) {
        case Ok(value: n):  { return Result::Ok(value: buf); }
        case Err(error: e): { return Result::Err(error: e); }
    };
}
