import { sodium::SodiumError, sodium::ready, std::collections::View, std::collections::ConstView };
export { PublicKey, SecretKey, KeyPair, Signature,
         PUBLICKEYBYTES, SECRETKEYBYTES, BYTES, SEEDBYTES, sign, verify };

// Ed25519 detached signatures. A `KeyPair` signs; anyone holding the `PublicKey` verifies. The
// signature is separate from the message (64 bytes, a value), so a signed message is the message plus
// a `Signature` beside it — the shape a protocol frame or a manifest wants.
//
// `verify` answers `bool`: it produces no data, so there is nothing for a `Result` to carry, and the
// only failure IS "no". A signature is public and copies freely; it is not a secret.

comptime isize PUBLICKEYBYTES = 32;   // crypto_sign_PUBLICKEYBYTES, pinned in csrc/kama_sodium.c
comptime isize SECRETKEYBYTES = 64;   // crypto_sign_SECRETKEYBYTES
comptime isize BYTES          = 64;   // crypto_sign_BYTES
comptime isize SEEDBYTES      = 32;   // crypto_sign_SEEDBYTES

extern "kama_sodium.h";
extern fn int32 crypto_sign_keypair(UnsafePtr<uint8> pk, UnsafePtr<uint8> sk);
extern fn int32 crypto_sign_seed_keypair(UnsafePtr<uint8> pk, UnsafePtr<uint8> sk, UnsafeConstPtr<uint8> seed);
extern fn int32 kama_sodium_sign_detached(UnsafePtr<uint8> sig, UnsafeConstPtr<uint8> m, uint64 mlen,
                                          UnsafeConstPtr<uint8> sk);
extern fn int32 crypto_sign_verify_detached(UnsafeConstPtr<uint8> sig, UnsafeConstPtr<uint8> m, uint64 mlen,
                                            UnsafeConstPtr<uint8> pk);
extern fn void  sodium_memzero(UnsafePtr<uint8> pnt, usize len);
extern fn int32 crypto_sign_ed25519_sk_to_pk(UnsafePtr<uint8> pk, UnsafeConstPtr<uint8> sk);

type value PublicKey {
    InlineArray<uint8>#(32) bytes;

    // All-zero bytes, to be filled. Public because kama's member visibility is per TYPE (there is no
    // module-internal tier), and the functions that fill it live outside the type; every path that
    // mints one fills it before it leaves.
    public ctor zeroed() { this.bytes = [0; 32]; }

    public unsafe ctor Result<PublicKey, SodiumError> fromBytes(ConstView<uint8> bytes) {
        if (bytes.length() != PUBLICKEYBYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: PUBLICKEYBYTES, got: bytes.length()));
        }
        PublicKey k = PublicKey.zeroed();
        isize i = 0;
        while (i < PUBLICKEYBYTES) { k.bytes[cast<usize>(i)] = bytes[i]; i = i + 1; }
        return Result::Ok(value: k);
    }

    public unsafe const fn void exportTo(View<uint8> into) {
        if (into.length() != PUBLICKEYBYTES) { panic(msg: "sign::PublicKey.exportTo: the buffer is not PUBLICKEYBYTES long"); }
        isize i = 0;
        while (i < PUBLICKEYBYTES) { into[i] = this.bytes[cast<usize>(i)]; i = i + 1; }
    }

    // The bytes, for libsodium: read-only and `const`, so a `const ref PublicKey` can reach C.
    // `rawMut()` is the writable half, and it exists because `KeyPair`'s constructors have to hand
    // libsodium a buffer to FILL — and a field is private to its own type, so `KeyPair` cannot reach
    // `this.pk.bytes` itself. Non-const on purpose: a `const ref` holder can never call it.
    public unsafe const fn UnsafeConstPtr<uint8> raw()    { return this.bytes.dataPtr(); }
    public unsafe fn       UnsafePtr<uint8>      rawMut() { return this.bytes.dataPtrMut(); }
}

// 64 bytes: the seed and the public key, as libsodium lays it out.
type resource SecretKey {
    InlineArray<uint8>#(64) bytes;

    // All-zero bytes, to be filled. Public because kama's member visibility is per TYPE (there is no
    // module-internal tier), and the functions that fill it live outside the type; every path that
    // mints one fills it before it leaves.
    public ctor zeroed() { this.bytes = [0; 64]; }

    public unsafe ctor Result<SecretKey, SodiumError> fromBytes(ConstView<uint8> bytes) {
        if (bytes.length() != SECRETKEYBYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: SECRETKEYBYTES, got: bytes.length()));
        }
        SecretKey k = SecretKey.zeroed();
        isize i = 0;
        while (i < SECRETKEYBYTES) { k.bytes[cast<usize>(i)] = bytes[i]; i = i + 1; }
        return Result::Ok(value: k);
    }

    public unsafe const fn void exportTo(View<uint8> into) {
        if (into.length() != SECRETKEYBYTES) { panic(msg: "sign::SecretKey.exportTo: the buffer is not SECRETKEYBYTES long"); }
        isize i = 0;
        while (i < SECRETKEYBYTES) { into[i] = this.bytes[cast<usize>(i)]; i = i + 1; }
    }

    public unsafe const fn UnsafeConstPtr<uint8> raw()    { return this.bytes.dataPtr(); }
    public unsafe fn       UnsafePtr<uint8>      rawMut() { return this.bytes.dataPtrMut(); }

    unsafe ~SecretKey() { sodium_memzero(pnt: this.bytes.dataPtrMut(), len: cast<usize>(SECRETKEYBYTES)); }
}

type resource KeyPair {
    // A field of a `resource` is always private in kama, so the pair is what the operations take —
    // by `const ref`, since they only read it. The public half is read out as a value
    // (`PublicKey pk = pair.publicKey();` — what goes on the wire) and the secret half never leaves
    // except through `exportSecretKeyTo`, for storage.
    PublicKey pk;
    SecretKey sk;

    // By value, not `ref`: a PublicKey is 32 bytes and a `type value`, so the copy is what a caller
    // wants anyway, and it makes the accessor reachable from a `const ref KeyPair`. A non-const `ref`
    // parameter still refuses a temporary — by design, since the mutation would be lost — but nothing
    // here takes a public key that way any more.
    public const fn PublicKey publicKey() { return this.pk; }

    // For the module's own operations (a free function cannot read a private field, even in this file).
    // Read-only: every call site here passes them to libsodium as inputs, so neither needs a mutable
    // form. The pair's two halves are FILLED inside the constructors below, through `rawMut()`.
    public unsafe const fn UnsafeConstPtr<uint8> rawPublicKey() { return this.pk.raw(); }
    public unsafe const fn UnsafeConstPtr<uint8> rawSecretKey() { return this.sk.raw(); }

    public unsafe const fn void exportSecretKeyTo(View<uint8> into) { this.sk.exportTo(into: into); }

    // Rebuild the pair from a stored secret key: the public half is derived.
    public unsafe ctor fromSecretKey(SecretKey secretKey) {
        ready();
        this.pk = PublicKey.zeroed();
        this.sk = give secretKey;
        int32 rc = crypto_sign_ed25519_sk_to_pk(pk: this.pk.rawMut(), sk: this.sk.raw());
    }


    public unsafe ctor random() {
        ready();
        this.pk = PublicKey.zeroed();
        this.sk = SecretKey.zeroed();
        int32 rc = crypto_sign_keypair(pk: this.pk.rawMut(), sk: this.sk.rawMut());
    }

    public unsafe ctor Result<KeyPair, SodiumError> fromSeed(ConstView<uint8> seed) {
        if (seed.length() != SEEDBYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: SEEDBYTES, got: seed.length()));
        }
        ready();
        KeyPair p = KeyPair.random();
        int32 rc = crypto_sign_seed_keypair(pk: p.pk.rawMut(), sk: p.sk.rawMut(), seed: addr(of: seed[0]));
        return Result::Ok(value: p);
    }
}

type value Signature {
    InlineArray<uint8>#(64) bytes;

    // All-zero bytes, to be filled. Public because kama's member visibility is per TYPE (there is no
    // module-internal tier), and the functions that fill it live outside the type; every path that
    // mints one fills it before it leaves.
    public ctor zeroed() { this.bytes = [0; 64]; }

    public unsafe ctor Result<Signature, SodiumError> fromBytes(ConstView<uint8> bytes) {
        if (bytes.length() != BYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: BYTES, got: bytes.length()));
        }
        Signature s = Signature.zeroed();
        isize i = 0;
        while (i < BYTES) { s.bytes[cast<usize>(i)] = bytes[i]; i = i + 1; }
        return Result::Ok(value: s);
    }

    public unsafe const fn void exportTo(View<uint8> into) {
        if (into.length() != BYTES) { panic(msg: "sign::Signature.exportTo: the buffer is not BYTES long"); }
        isize i = 0;
        while (i < BYTES) { into[i] = this.bytes[cast<usize>(i)]; i = i + 1; }
    }

    // Read-only for `verify`, which only reads a signature; `rawMut()` is the buffer `sign` fills.
    public unsafe const fn UnsafeConstPtr<uint8> raw()    { return this.bytes.dataPtr(); }
    public unsafe fn       UnsafePtr<uint8>      rawMut() { return this.bytes.dataPtrMut(); }
}

// Sign `message` with the pair's secret key. Deterministic: the same key and message give the same signature.
unsafe fn Signature sign(ConstView<uint8> message, const ref KeyPair key) {
    ready();
    Signature s = Signature.zeroed();
    // An empty message is signable. libsodium takes a pointer it will not read for mlen 0, and a View
    // has no address to give for length 0 — the signature buffer stands in. Declared and assigned
    // rather than a ternary: the two arms are `UnsafeConstPtr` and `UnsafePtr`, which do not unify.
    UnsafeConstPtr<uint8> m = s.raw();
    if (message.length() != 0) { m = addr(of: message[0]); }
    int32 rc = kama_sodium_sign_detached(sig: s.rawMut(), m: m, mlen: cast<uint64>(message.length()), sk: key.rawSecretKey());
    if (rc != 0) { panic(msg: "sign::sign: signing failed"); }
    return s;
}

// Does `signature` sign `message` under the pair whose public half is `key`? `false` for a forged or
// altered signature, an altered message, or another signer.
unsafe fn bool verify(const ref Signature signature, ConstView<uint8> message, const ref PublicKey key) {
    ready();
    UnsafeConstPtr<uint8> m = signature.raw();
    if (message.length() != 0) { m = addr(of: message[0]); }
    return crypto_sign_verify_detached(sig: signature.raw(), m: m, mlen: cast<uint64>(message.length()), pk: key.raw()) == 0;
}
