import { sodium::SodiumError, sodium::ready, std::collections::View, std::collections::ConstView };
export { PublicKey, SecretKey, KeyPair, SessionKey, SessionKeys, Direction,
         PUBLICKEYBYTES, SECRETKEYBYTES, SESSIONKEYBYTES, SEEDBYTES,
         clientSessionKeys, serverSessionKeys };

// Key exchange: X25519 into DIRECTIONAL session keys. Each side has a key pair; each learns the other's
// public key (out of band, or signed — `sodium::sign`); then the client derives (rx, tx) and the server
// derives (rx, tx) such that client.tx == server.rx and client.rx == server.tx. Two keys, one per
// direction, so a packet can never be replayed back at its sender as if the peer had said it.
//
// A session key becomes a channel key without a plaintext copy: `aead::Key.fromSession(keys:,
// direction:)` or `secretbox::Key.fromSession(keys:, direction:)`. The exchange itself authenticates
// nobody — that is what signing the public keys (or a pre-shared server key in the client) is for.

comptime isize PUBLICKEYBYTES  = 32;   // crypto_kx_PUBLICKEYBYTES, pinned in csrc/kama_sodium.c
comptime isize SECRETKEYBYTES  = 32;   // crypto_kx_SECRETKEYBYTES
comptime isize SESSIONKEYBYTES = 32;   // crypto_kx_SESSIONKEYBYTES
comptime isize SEEDBYTES       = 32;   // crypto_kx_SEEDBYTES

extern "kama_sodium.h";
extern fn int32 crypto_kx_keypair(UnsafePtr<uint8> pk, UnsafePtr<uint8> sk);
extern fn int32 crypto_kx_seed_keypair(UnsafePtr<uint8> pk, UnsafePtr<uint8> sk, UnsafeConstPtr<uint8> seed);
extern fn int32 crypto_kx_client_session_keys(UnsafePtr<uint8> rx, UnsafePtr<uint8> tx,
                                              UnsafeConstPtr<uint8> client_pk, UnsafeConstPtr<uint8> client_sk,
                                              UnsafeConstPtr<uint8> server_pk);
extern fn int32 crypto_kx_server_session_keys(UnsafePtr<uint8> rx, UnsafePtr<uint8> tx,
                                              UnsafeConstPtr<uint8> server_pk, UnsafeConstPtr<uint8> server_sk,
                                              UnsafeConstPtr<uint8> client_pk);
extern fn void  sodium_memzero(UnsafePtr<uint8> pnt, usize len);
extern fn int32 crypto_scalarmult_base(UnsafePtr<uint8> q, UnsafeConstPtr<uint8> n);
extern fn UnsafePtr<uint8> kama_sodium_copy(UnsafePtr<uint8> dst, UnsafeConstPtr<uint8> src, usize n);

type value PublicKey {
    InlineArray<uint8>#(32) bytes;

    // All-zero bytes, to be filled. Public because kama's member visibility is per TYPE (there is no
    // module-internal tier), and the functions that fill it live outside the type; every path that
    // mints one fills it before it leaves.
    public ctor zeroed() { this.bytes = [0; 32]; }

    public unsafe ctor Result<PublicKey, SodiumError> fromBytes(ConstView<uint8> bytes) {
        if (bytes.length() != PUBLICKEYBYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: PUBLICKEYBYTES, got: bytes.length()));
        }
        PublicKey k = PublicKey.zeroed();
        isize i = 0;
        while (i < PUBLICKEYBYTES) { k.bytes[cast<usize>(i)] = bytes[i]; i = i + 1; }
        return Result::Ok(value: k);
    }

    public unsafe const fn void exportTo(View<uint8> into) {
        if (into.length() != PUBLICKEYBYTES) { panic(msg: "kx::PublicKey.exportTo: the buffer is not PUBLICKEYBYTES long"); }
        isize i = 0;
        while (i < PUBLICKEYBYTES) { into[i] = this.bytes[cast<usize>(i)]; i = i + 1; }
    }

    // The bytes, for libsodium: read-only and `const`, so a `const ref PublicKey` can reach C.
    // `rawMut()` is the writable half, and it exists because `KeyPair`'s constructors have to hand
    // libsodium a buffer to FILL — and a field is private to its own type, so `KeyPair` cannot reach
    // `this.pk.bytes` itself. Non-const on purpose: a `const ref` holder can never call it.
    public unsafe const fn UnsafeConstPtr<uint8> raw()    { return this.bytes.dataPtr(); }
    public unsafe fn       UnsafePtr<uint8>      rawMut() { return this.bytes.dataPtrMut(); }
}

type resource SecretKey {
    InlineArray<uint8>#(32) bytes;

    // All-zero bytes, to be filled. Public because kama's member visibility is per TYPE (there is no
    // module-internal tier), and the functions that fill it live outside the type; every path that
    // mints one fills it before it leaves.
    public ctor zeroed() { this.bytes = [0; 32]; }

    public unsafe ctor Result<SecretKey, SodiumError> fromBytes(ConstView<uint8> bytes) {
        if (bytes.length() != SECRETKEYBYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: SECRETKEYBYTES, got: bytes.length()));
        }
        SecretKey k = SecretKey.zeroed();
        isize i = 0;
        while (i < SECRETKEYBYTES) { k.bytes[cast<usize>(i)] = bytes[i]; i = i + 1; }
        return Result::Ok(value: k);
    }

    public unsafe const fn void exportTo(View<uint8> into) {
        if (into.length() != SECRETKEYBYTES) { panic(msg: "kx::SecretKey.exportTo: the buffer is not SECRETKEYBYTES long"); }
        isize i = 0;
        while (i < SECRETKEYBYTES) { into[i] = this.bytes[cast<usize>(i)]; i = i + 1; }
    }

    public unsafe const fn UnsafeConstPtr<uint8> raw()    { return this.bytes.dataPtr(); }
    public unsafe fn       UnsafePtr<uint8>      rawMut() { return this.bytes.dataPtrMut(); }

    unsafe ~SecretKey() { sodium_memzero(pnt: this.bytes.dataPtrMut(), len: cast<usize>(SECRETKEYBYTES)); }
}

// A key pair. `random()` for a fresh identity; `fromSeed` for a deterministic one (a seed stored once,
// the pair re-derived at start — the seed is as secret as the secret key).
type resource KeyPair {
    // A field of a `resource` is always private in kama, so the pair is what the operations take —
    // by `const ref`, since they only read it. The public half is read out as a value
    // (`PublicKey pk = pair.publicKey();` — what goes on the wire) and the secret half never leaves
    // except through `exportSecretKeyTo`, for storage.
    PublicKey pk;
    SecretKey sk;

    // By value, not `ref`: a PublicKey is 32 bytes and a `type value`, so the copy is what a caller
    // wants anyway, and it makes the accessor reachable from a `const ref KeyPair`. A non-const `ref`
    // parameter still refuses a temporary — by design, since the mutation would be lost — but nothing
    // here takes a public key that way any more.
    public const fn PublicKey publicKey() { return this.pk; }

    // For the module's own operations (a free function cannot read a private field, even in this file).
    // Read-only: every call site here passes them to libsodium as inputs, so neither needs a mutable
    // form. The pair's two halves are FILLED inside the constructors below, through `rawMut()`.
    public unsafe const fn UnsafeConstPtr<uint8> rawPublicKey() { return this.pk.raw(); }
    public unsafe const fn UnsafeConstPtr<uint8> rawSecretKey() { return this.sk.raw(); }

    public unsafe const fn void exportSecretKeyTo(View<uint8> into) { this.sk.exportTo(into: into); }

    // Rebuild the pair from a stored secret key: the public half is derived.
    public unsafe ctor fromSecretKey(SecretKey secretKey) {
        ready();
        this.pk = PublicKey.zeroed();
        this.sk = give secretKey;
        int32 rc = crypto_scalarmult_base(q: this.pk.rawMut(), n: this.sk.raw());
    }


    public unsafe ctor random() {
        ready();
        this.pk = PublicKey.zeroed();
        this.sk = SecretKey.zeroed();
        int32 rc = crypto_kx_keypair(pk: this.pk.rawMut(), sk: this.sk.rawMut());
    }

    public unsafe ctor Result<KeyPair, SodiumError> fromSeed(ConstView<uint8> seed) {
        if (seed.length() != SEEDBYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: SEEDBYTES, got: seed.length()));
        }
        ready();
        KeyPair p = KeyPair.random();
        int32 rc = crypto_kx_seed_keypair(pk: p.pk.rawMut(), sk: p.sk.rawMut(), seed: addr(of: seed[0]));
        return Result::Ok(value: p);
    }
}

// One direction's key. Move-only, zeroed on drop, and never exported as bytes: it goes into an
// `aead::Key` or a `secretbox::Key` through `fromSession`, which copies it straight into the key.
type resource SessionKey {
    InlineArray<uint8>#(32) bytes;

    // All-zero bytes, to be filled. Public because kama's member visibility is per TYPE (there is no
    // module-internal tier), and the functions that fill it live outside the type; every path that
    // mints one fills it before it leaves.
    public ctor zeroed() { this.bytes = [0; 32]; }

    // Write-only. Nothing READS a session key through a pointer — it leaves only by being copied
    // into a channel key (`copyRawInto` below) — so there is no `raw()`, and `rawMut()` exists solely
    // for `SessionKeys` to hand libsodium a buffer to fill.
    public unsafe fn UnsafePtr<uint8> rawMut() { return this.bytes.dataPtrMut(); }

    // For `aead::Key.fromSession` and `secretbox::Key.fromSession`: 32 bytes into the key's own
    // storage, and nowhere else. `const` so a `const ref SessionKeys` can still hand its bytes over.
    public unsafe const fn void copyRawInto(UnsafePtr<uint8> dst) {
        UnsafePtr<uint8> r = kama_sodium_copy(dst: dst, src: this.bytes.dataPtr(), n: cast<usize>(SESSIONKEYBYTES));
    }

    unsafe ~SessionKey() { sodium_memzero(pnt: this.bytes.dataPtrMut(), len: cast<usize>(SESSIONKEYBYTES)); }
}

// The pair a side ends up with: `rx` opens what the peer sealed with its `tx`, `tx` seals what the peer
// opens with its `rx`.
// Which of a side's two session keys: `Rx` opens what the peer sends, `Tx` seals what this side sends.
type enum Direction { Rx, Tx; }

type resource SessionKeys {
    SessionKey rxKey;
    SessionKey txKey;

    // All-zero bytes, to be filled (see PublicKey.zeroed).
    public ctor zeroed() { this.rxKey = SessionKey.zeroed(); this.txKey = SessionKey.zeroed(); }

    // Write-only, for the two `*SessionKeys` functions below to fill. See `SessionKey.rawMut`.
    public unsafe fn UnsafePtr<uint8> rawRxMut() { return this.rxKey.rawMut(); }
    public unsafe fn UnsafePtr<uint8> rawTxMut() { return this.txKey.rawMut(); }

    // One direction's 32 bytes into a channel key's own storage — how `aead::Key.fromSession` and
    // `secretbox::Key.fromSession` take a session key with no plaintext copy in between.
    public unsafe const fn void copyInto(Direction direction, UnsafePtr<uint8> dst) {
        match (direction) {
            case Rx: { this.rxKey.copyRawInto(dst: dst); }
            case Tx: { this.txKey.copyRawInto(dst: dst); }
        };
    }
}

// The client's keys, from its own pair and the server's public key. `Err(InvalidPublicKey)` if the
// server's key is not a valid point.
unsafe fn Result<SessionKeys, SodiumError> clientSessionKeys(const ref KeyPair client, const ref PublicKey server) {
    ready();
    SessionKeys s = SessionKeys.zeroed();
    int32 rc = crypto_kx_client_session_keys(rx: s.rawRxMut(), tx: s.rawTxMut(),
                                             client_pk: client.rawPublicKey(), client_sk: client.rawSecretKey(),
                                             server_pk: server.raw());
    if (rc != 0) { return Result::Err(error: SodiumError::InvalidPublicKey); }
    return Result::Ok(value: s);
}

// The server's keys, from its own pair and the client's public key.
unsafe fn Result<SessionKeys, SodiumError> serverSessionKeys(const ref KeyPair server, const ref PublicKey client) {
    ready();
    SessionKeys s = SessionKeys.zeroed();
    int32 rc = crypto_kx_server_session_keys(rx: s.rawRxMut(), tx: s.rawTxMut(),
                                             server_pk: server.rawPublicKey(), server_sk: server.rawSecretKey(),
                                             client_pk: client.raw());
    if (rc != 0) { return Result::Err(error: SodiumError::InvalidPublicKey); }
    return Result::Ok(value: s);
}
