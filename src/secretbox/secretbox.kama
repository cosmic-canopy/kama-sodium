import { sodium::SodiumError, sodium::Nonce, sodium::ready, sodium::kx::SessionKeys, sodium::kx::Direction,
         std::collections::View, std::collections::FixedArray };
export { Key, KEYBYTES, MACBYTES, seal, open, sealInto, openInto };

// Secret-key authenticated encryption: XSalsa20-Poly1305 (`crypto_secretbox_easy`). One key both ends
// hold, a nonce that is never reused under that key, and a ciphertext MACBYTES longer than its message
// that `open` refuses to decrypt unless it is exactly what `seal` produced.
//
// No associated data: if a header must travel in the clear and still be authenticated (a packet's
// sequence number), that is `sodium::aead`. The nonce is `sodium::Nonce` (24 bytes; random per message
// is safe with no bookkeeping).

comptime isize KEYBYTES   = 32;   // crypto_secretbox_KEYBYTES,   pinned in csrc/kama_sodium.c
comptime isize MACBYTES   = 16;   // crypto_secretbox_MACBYTES

extern "kama_sodium.h";
extern fn void  crypto_secretbox_keygen(UnsafePtr<uint8> k);
extern fn int32 crypto_secretbox_easy(UnsafePtr<uint8> c, UnsafePtr<uint8> m, uint64 mlen,
                                      UnsafePtr<uint8> n, UnsafePtr<uint8> k);
extern fn int32 crypto_secretbox_open_easy(UnsafePtr<uint8> m, UnsafePtr<uint8> c, uint64 clen,
                                           UnsafePtr<uint8> n, UnsafePtr<uint8> k);
extern fn void  sodium_memzero(UnsafePtr<uint8> pnt, usize len);

// The key: a resource, so it moves and is never silently duplicated, and its bytes are zeroed when it
// goes away. `random()` is how a key is born; `fromBytes` is how one arrives from storage or a key
// exchange; `exportTo` is the only way its bytes leave, into a buffer the caller owns.
type resource Key {
    InlineArray<uint8>#(32) bytes;

    // All-zero bytes, to be filled. Public because kama's member visibility is per TYPE (there is no
    // module-internal tier), and the functions that fill it live outside the type; every path that
    // mints one fills it before it leaves.
    public ctor zeroed() { this.bytes = [0; 32]; }

    public unsafe ctor random() {
        ready();
        this.bytes = [0; 32];
        crypto_secretbox_keygen(k: this.bytes.dataPtr());
    }

    public unsafe ctor Result<Key, SodiumError> fromBytes(View<uint8> bytes) {
        if (bytes.length() != KEYBYTES) {
            return Result::Err(error: SodiumError::BadLength(expected: KEYBYTES, got: bytes.length()));
        }
        Key k = Key.zeroed();
        isize i = 0;
        while (i < KEYBYTES) { k.bytes[cast<usize>(i)] = bytes[i]; i = i + 1; }
        return Result::Ok(value: k);
    }

    // A `kx` session key, straight into the key's own storage — no plaintext copy in between.
    public unsafe ctor fromSession(ref SessionKeys keys, Direction direction) {
        this.bytes = [0; 32];
        keys.copyInto(direction: direction, dst: this.bytes.dataPtr());
    }

    // Copy the key's bytes out, into a buffer of exactly KEYBYTES. The caller now holds a secret in
    // plain memory and owns its zeroing (`sodium::memzero`).
    public unsafe fn void exportTo(View<uint8> into) {
        if (into.length() != KEYBYTES) { panic(msg: "secretbox::Key.exportTo: the buffer is not KEYBYTES long"); }
        isize i = 0;
        while (i < KEYBYTES) { into[i] = this.bytes[cast<usize>(i)]; i = i + 1; }
    }

    // The bytes, for libsodium. `ref`, not `const ref`, on every call that takes a key: kama has no
    // const raw pointer, and `addr(of:)` on a const receiver is refused by design ("const is deep"), so
    // the borrow at the C seam is the mutable one — honest about what C could do, if not about what
    // libsodium does.
    public unsafe fn UnsafePtr<uint8> raw() { return this.bytes.dataPtr(); }

    unsafe ~Key() { sodium_memzero(pnt: this.bytes.dataPtr(), len: cast<usize>(KEYBYTES)); }
}

// Encrypt and authenticate `message` into `out`, which must be exactly message.length() + MACBYTES.
// Answers the bytes written. Allocates nothing; the per-packet form.
unsafe fn isize sealInto(View<uint8> into, View<uint8> message, ref Nonce nonce, ref Key key) {
    ready();
    if (into.length() != message.length() + MACBYTES) {
        panic(msg: "secretbox::sealInto: `into` must be message.length() + MACBYTES");
    }
    // An empty message is a valid one: its box is a bare MAC. libsodium takes a pointer it will not
    // read for mlen 0, and a View has no address to give for length 0 — the MAC buffer stands in.
    UnsafePtr<uint8> m = message.length() == 0 ? addr(of: into[0]) : addr(of: message[0]);
    int32 rc = crypto_secretbox_easy(c: addr(of: into[0]), m: m, mlen: cast<uint64>(message.length()),
                                     n: nonce.raw(), k: key.raw());
    if (rc != 0) { panic(msg: "secretbox::sealInto: crypto_secretbox_easy failed"); }
    return into.length();
}

// Verify and decrypt `ciphertext` into `out`, which must be exactly ciphertext.length() - MACBYTES.
// `Err(Forged)` if the box was not sealed under this key and nonce, or was altered since; `out` is then
// not to be trusted. A ciphertext shorter than a MAC cannot be a box and is a `BadLength`.
unsafe fn Result<isize, SodiumError> openInto(View<uint8> into, View<uint8> ciphertext,
                                              ref Nonce nonce, ref Key key) {
    ready();
    if (ciphertext.length() < MACBYTES) {
        return Result::Err(error: SodiumError::BadLength(expected: MACBYTES, got: ciphertext.length()));
    }
    isize plain = ciphertext.length() - MACBYTES;
    if (into.length() != plain) {
        panic(msg: "secretbox::openInto: `into` must be ciphertext.length() - MACBYTES");
    }
    UnsafePtr<uint8> m = plain == 0 ? addr(of: ciphertext[0]) : addr(of: into[0]);
    int32 rc = crypto_secretbox_open_easy(m: m, c: addr(of: ciphertext[0]), clen: cast<uint64>(ciphertext.length()),
                                          n: nonce.raw(), k: key.raw());
    if (rc != 0) { return Result::Err(error: SodiumError::Forged); }
    return Result::Ok(value: plain);
}

// The allocating forms: a fresh buffer of the right size, then the `into` form.
unsafe fn FixedArray<uint8> seal(View<uint8> message, ref Nonce nonce, ref Key key) {
    FixedArray<uint8> buf = FixedArray::<uint8>.make(size: message.length() + MACBYTES);
    isize n = sealInto(into: buf.view(), message: message, nonce: nonce, key: key);
    return buf;
}

unsafe fn Result<FixedArray<uint8>, SodiumError> open(View<uint8> ciphertext, ref Nonce nonce, ref Key key) {
    if (ciphertext.length() < MACBYTES) {
        return Result::Err(error: SodiumError::BadLength(expected: MACBYTES, got: ciphertext.length()));
    }
    FixedArray<uint8> buf = FixedArray::<uint8>.make(size: ciphertext.length() - MACBYTES);
    match (openInto(into: buf.view(), ciphertext: ciphertext, nonce: nonce, key: key)) {
        case Ok(value: n):  { return Result::Ok(value: buf); }
        case Err(error: e): { return Result::Err(error: e); }
    };
}
