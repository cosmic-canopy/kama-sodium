import { sodium::SodiumError, sodium::equalsConstantTime,
         sodium::Nonce, sodium::NONCEBYTES, sodium::secretbox::Key, sodium::secretbox::KEYBYTES,
         sodium::secretbox::MACBYTES,
         sodium::secretbox::seal, sodium::secretbox::open,
         sodium::secretbox::sealInto, sodium::secretbox::openInto,
         sodium_tests::check, sodium_tests::unhex, sodium_tests::isForged, sodium_tests::isBadLength,
         std::collections::View, std::collections::FixedArray, std::collections::DynamicArray };
export { secretboxTests };

fn int32 knownAnswer() {
    // libsodium's own vector (test/default/secretbox.c): firstkey / nonce / m -> c.
    DynamicArray<uint8> kb = unhex(text: "1b27556473e985d462cd51197a9a46c76009549eac6474f206c4ee0844f68389");
    DynamicArray<uint8> nb = unhex(text: "69696ee955b62b73cd62bda875fc73d68219e0036b7a0b37");
    DynamicArray<uint8> mb = unhex(text: "be075fc53c81f2d5cf141316ebeb0c7b5228c52a4c62cbd44b66849b64244ffce5ecbaaf33bd751a1ac728d45e6c61296cdc3c01233561f41db66cce314adb310e3be8250c46f06dceea3a7fa1348057e2f6556ad6b1318a024a838f21af1fde048977eb48f59ffd4924ca1c60902e52f0a089bc76897040e082f937763848645e0705");
    DynamicArray<uint8> cb = unhex(text: "f3ffc7703f9400e52a7dfb4b3d3305d98e993b9f48681273c29650ba32fc76ce48332ea7164d96a4476fb8c531a1186ac0dfc17c98dce87b4da7f011ec48c97271d2c20f9b928fe2270d6fb863d51738b48eeee314a7cc8ab932164548e526ae90224368517acfeabd6bb3732bc0e9da99832b61ca01b6de56244a9e88d5f9b37973f622a43d14a6599b1f654cb45a74e355a5");
    int32 f = 0;
    // Two unwrap spellings, by the payload's kind. A VALUE payload (Nonce) is copied out of a borrowing
    // `match (r)`; a RESOURCE payload (Key) leaves by `give` out of a consuming `match (give r)`.
    Result<Nonce, SodiumError> nr = Nonce.fromBytes(bytes: nb.view());
    Nonce nonce = match (nr) { case Ok(value: n): n; case Err(error: e): { panic(msg: "vector nonce"); return 1; } };
    Result<Key, SodiumError> kr = Key.fromBytes(bytes: kb.view());
    Key key = match (give kr) { case Ok(value: k): give k; case Err(error: e): { panic(msg: "vector key"); return 1; } };
    FixedArray<uint8> sealed = seal(message: mb.view(), nonce: nonce, key: key);
    f = f + check(ok: equalsConstantTime(a: sealed.view(), b: cb.view()), what: "secretbox: known-answer ciphertext");
    match (open(ciphertext: cb.view(), nonce: nonce, key: key)) {
        case Ok(value: p):  { f = f + check(ok: equalsConstantTime(a: p.view(), b: mb.view()), what: "secretbox: known-answer plaintext"); }
        case Err(error: e): { f = f + check(ok: false, what: "secretbox: known-answer open failed"); }
    };
    return f;
}

fn int32 secretboxTests() {
    int32 f = 0;
    f = f + check(ok: KEYBYTES == 32 && NONCEBYTES == 24 && MACBYTES == 16, what: "secretbox: sizes");
    f = f + knownAnswer();

    Key key = Key.random();
    Nonce nonce = Nonce.random();
    FixedArray<uint8> msg = FixedArray::<uint8>.make(size: 100);
    isize i = 0;
    while (i < 100) { msg[i] = truncate<uint8>(i * 7); i = i + 1; }

    // Round trip, allocating forms.
    FixedArray<uint8> boxed = seal(message: msg.view(), nonce: nonce, key: key);
    f = f + check(ok: boxed.length() == 116, what: "secretbox: sealed length is message + MACBYTES");
    match (open(ciphertext: boxed.view(), nonce: nonce, key: key)) {
        case Ok(value: p):  { f = f + check(ok: equalsConstantTime(a: p.view(), b: msg.view()), what: "secretbox: round trip"); }
        case Err(error: e): { f = f + check(ok: false, what: "secretbox: round trip open failed"); }
    };

    // One flipped byte is Forged, in the body or in the MAC.
    boxed[50] = boxed[50] ^ 1ui8;
    f = f + check(ok: isForged(r: open(ciphertext: boxed.view(), nonce: nonce, key: key)), what: "secretbox: a flipped body byte is Forged");
    boxed[50] = boxed[50] ^ 1ui8;
    boxed[3] = boxed[3] ^ 128ui8;
    f = f + check(ok: isForged(r: open(ciphertext: boxed.view(), nonce: nonce, key: key)), what: "secretbox: a flipped MAC byte is Forged");
    boxed[3] = boxed[3] ^ 128ui8;

    // The wrong key, and the wrong nonce, are Forged too — and the right pair still opens afterwards.
    Key other = Key.random();
    f = f + check(ok: isForged(r: open(ciphertext: boxed.view(), nonce: nonce, key: other)), what: "secretbox: the wrong key is Forged");
    Nonce nonce2 = nonce;
    nonce2.increment();
    f = f + check(ok: isForged(r: open(ciphertext: boxed.view(), nonce: nonce2, key: key)), what: "secretbox: the wrong nonce is Forged");
    f = f + check(ok: !isForged(r: open(ciphertext: boxed.view(), nonce: nonce, key: key)), what: "secretbox: reopens after the wrong attempts");

    // A ciphertext shorter than a MAC is BadLength, not Forged.
    FixedArray<uint8> tiny = FixedArray::<uint8>.make(size: 5);
    f = f + check(ok: isBadLength(r: open(ciphertext: tiny.view(), nonce: nonce, key: key), expected: 16, got: 5), what: "secretbox: a 5-byte ciphertext is BadLength(16, 5)");

    // The `into` forms: caller's buffers, no allocation, and the byte counts.
    FixedArray<uint8> outBuf = FixedArray::<uint8>.make(size: 116);
    isize wrote = sealInto(into: outBuf.view(), message: msg.view(), nonce: nonce, key: key);
    f = f + check(ok: wrote == 116, what: "secretbox: sealInto writes message + MACBYTES");
    f = f + check(ok: equalsConstantTime(a: outBuf.view(), b: boxed.view()), what: "secretbox: sealInto matches seal");
    FixedArray<uint8> plainBuf = FixedArray::<uint8>.make(size: 100);
    match (openInto(into: plainBuf.view(), ciphertext: outBuf.view(), nonce: nonce, key: key)) {
        case Ok(value: n):  { f = f + check(ok: n == 100 && equalsConstantTime(a: plainBuf.view(), b: msg.view()), what: "secretbox: openInto round trip"); }
        case Err(error: e): { f = f + check(ok: false, what: "secretbox: openInto failed"); }
    };

    // An empty message is a valid one: its box is a bare MAC, and it opens to nothing.
    FixedArray<uint8> empty = FixedArray::<uint8>.make(size: 0);
    FixedArray<uint8> emptyBox = seal(message: empty.view(), nonce: nonce, key: key);
    f = f + check(ok: emptyBox.length() == 16, what: "secretbox: an empty message seals to a bare MAC");
    match (open(ciphertext: emptyBox.view(), nonce: nonce, key: key)) {
        case Ok(value: p):  { f = f + check(ok: p.length() == 0, what: "secretbox: an empty box opens to nothing"); }
        case Err(error: e): { f = f + check(ok: false, what: "secretbox: an empty box did not open"); }
    };

    // A key survives export and import; a wrong-length import is BadLength.
    FixedArray<uint8> kb = FixedArray::<uint8>.make(size: 32);
    key.exportTo(into: kb.view());
    match (Key.fromBytes(bytes: kb.view())) {
        case Ok(value: k2):  { f = f + check(ok: !isForged(r: open(ciphertext: boxed.view(), nonce: nonce, key: k2)), what: "secretbox: an exported key opens"); }
        case Err(error: e): { f = f + check(ok: false, what: "secretbox: fromBytes of an exported key"); }
    };
    match (Key.fromBytes(bytes: tiny.view())) {
        case Ok(value: k3):  { f = f + check(ok: false, what: "secretbox: a 5-byte key was accepted"); }
        case Err(error: e): { f = f + check(ok: true, what: ""); }
    };
    return f;
}
